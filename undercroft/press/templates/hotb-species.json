                  "bold": true
                },
                "className": "card-title",
                "label": "@name"
              },
              {
                "type": "field",
                "component": "text",
                "text": "Stack body text",
                "textSize": "md",
                "className": "mb-0"
              }
            ]
          }
        ]
      }
    },
    "back": {
      "data": "@",
      "layout": {
        "type": "stack",
        "gap": 4,
        "children": []
      }
    }
  },
  "card": {
    "width": 2.75,
    "height": 4.75,
    "gutter": 0,
    "safeInset": 0.125,
    "columns": 2,
    "rows": 2
