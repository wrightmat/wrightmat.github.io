{
  "type": "object",
  "$source": "ddb",
  "$description": "D&D Beyond Class",
  "fields": {
    "kind": {
      "type": "field",
      "bind": "@kind"
    },
    "name": {
      "type": "field",
      "bind": "@name"
    },
    "systemIds": {
      "type": "custom",
      "fn": "ddbClassSystemIds"
    },
    "primary_ability": {
      "type": "custom",
      "fn": "ddbPrimaryAbility"
    },
    "hit_die": {
      "type": "custom",
      "fn": "ddbHitDie"
    },
    "proficiency_choices": {
      "type": "custom",
      "fn": "ddbProficiencyChoices"
    },
    "proficiencies": {
      "type": "custom",
      "fn": "ddbProficiencies"
    },
    "saving_throws": {
      "type": "custom",
      "fn": "ddbSavingThrows"
    },
    "starting_equipment_options": {
      "type": "custom",
      "fn": "ddbEquipmentOptions"
    },
    "subclasses": {
      "type": "pipeline",
      "source": "@subclasses",
      "steps": [
        {
          "step": "map",
          "item": {
            "type": "object",
            "fields": {
              "index": {
                "type": "custom",
                "fn": "slug"
              },
              "name": {
                "type": "field",
                "bind": "@name"
              },
              "url": {
                "type": "field",
                "bind": "@root.url"
              }
            }
          }
        }
      ]
    },
    "url": {
      "type": "field",
      "bind": "@url"
    },
    "description": {
      "type": "custom",
      "fn": "joinLines"
    },
    "coreTraits": {
      "type": "field",
      "bind": "@coreTraits"
    },
    "features": {
      "type": "pipeline",
      "source": "@features",
      "steps": [
        {
          "step": "map",
          "item": {
            "type": "object",
            "fields": {
              "name": {
                "type": "field",
                "bind": "@name"
              },
              "level": {
                "type": "field",
                "bind": "@level"
              },
              "description": {
                "type": "custom",
                "fn": "joinLines"
              }
            }
          }
        }
      ]
    }
  }
}
