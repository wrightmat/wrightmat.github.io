{
  "type": "object",
  "$source": "srd",
  "$description": "5e API — Subclasses (SRD)",
  "$defaultSourceValue": "https://www.dnd5eapi.co/api/2014/subclasses",
  "fields": {
    "kind": {
      "type": "field",
      "bind": "='variant'"
    },
    "index": {
      "type": "custom",
      "fn": "compoundSlug",
      "args": {
        "parentPath": "class.index",
        "path": "index"
      }
    },
    "url": {
      "type": "field",
      "bind": "@url"
    },
    "name": {
      "type": "field",
      "bind": "@name"
    },
    "systemIds": {
      "type": "custom",
      "fn": "srdSubclassSystemIds"
    },
    "parentKind": {
      "type": "field",
      "bind": "='class'"
    },
    "parentId": {
      "type": "field",
      "bind": "@class.index"
    },
    "summary": {
      "type": "field",
      "bind": "@summary"
    },
    "description": {
      "type": "field",
      "bind": "@description"
    },
    "features": {
      "type": "field",
      "bind": "@features"
    }
  }
}
