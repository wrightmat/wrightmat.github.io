{
  "type": "pipeline",
  "$source": "ddb",
  "$description": "D&D Beyond Subclass",
  "source": "@subclasses",
  "steps": [
    {
      "step": "map",
      "item": {
        "type": "object",
        "fields": {
          "kind": {
            "type": "field",
            "bind": "='subclass'"
          },
          "index": {
            "type": "custom",
            "fn": "slug"
          },
          "url": {
            "type": "field",
            "bind": "@root.url"
          },
          "name": {
            "type": "field",
            "bind": "@name"
          },
          "class": {
            "type": "object",
            "fields": {
              "index": {
                "type": "custom",
                "fn": "slug",
                "args": {
                  "path": "root.name"
                }
              },
              "url": {
                "type": "field",
                "bind": "@root.url"
              },
              "name": {
                "type": "field",
                "bind": "@root.name"
              }
            }
          },
          "summary": {
            "type": "field",
            "bind": "@descLines.0"
          },
          "description": {
            "type": "custom",
            "fn": "joinLines",
            "args": {
              "skip": 1
            }
          },
          "features": {
            "type": "pipeline",
            "source": "@features",
            "steps": [
              {
                "step": "map",
                "item": {
                  "type": "object",
                  "fields": {
                    "name": {
                      "type": "field",
                      "bind": "@name"
                    },
                    "level": {
                      "type": "field",
                      "bind": "@level"
                    },
                    "description": {
                      "type": "custom",
                      "fn": "joinLines"
                    }
                  }
                }
              }
            ]
          }
        }
      }
    }
  ]
}
