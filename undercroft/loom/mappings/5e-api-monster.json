{
  "type": "object",
  "$source": "srd",
  "fields": {
    "kind": {
      "type": "field",
      "bind": "='monster'"
    },
    "index": {
      "type": "field",
      "bind": "@index"
    },
    "name": {
      "type": "field",
      "bind": "@name"
    },
    "stats": {
      "type": "object",
      "fields": {
        "size": {
          "type": "field",
          "bind": "@size"
        },
        "type": {
          "type": "field",
          "bind": "@type"
        },
        "alignment": {
          "type": "field",
          "bind": "@alignment"
        },
        "armorClass": {
          "type": "field",
          "bind": "@armor_class"
        },
        "hitPoints": {
          "type": "object",
          "fields": {
            "max": {
              "type": "field",
              "bind": "@hit_points"
            },
            "current": {
              "type": "field",
              "bind": "@hit_points"
            }
          }
        },
        "hitDice": {
          "type": "field",
          "bind": "@hit_dice"
        },
        "hitPointsRoll": {
          "type": "field",
          "bind": "@hit_points_roll"
        },
        "speed": {
          "type": "custom",
          "fn": "formatSpeedFromObject",
          "args": {
            "path": "speed"
          }
        },
        "abilities": {
          "type": "object",
          "fields": {
            "strength": {
              "type": "field",
              "bind": "@strength"
            },
            "dexterity": {
              "type": "field",
              "bind": "@dexterity"
            },
            "constitution": {
              "type": "field",
              "bind": "@constitution"
            },
            "intelligence": {
              "type": "field",
              "bind": "@intelligence"
            },
            "wisdom": {
              "type": "field",
              "bind": "@wisdom"
            },
            "charisma": {
              "type": "field",
              "bind": "@charisma"
            }
          }
        },
        "initiativeBonus": {
          "type": "field",
          "bind": "=floor((@dexterity - 10) / 2)"
        },
        "proficiencies": {
          "type": "pipeline",
          "source": "@proficiencies",
          "steps": [
            {
              "step": "map",
              "item": {
                "type": "object",
                "fields": {
                  "name": {
                    "type": "field",
                    "bind": "@proficiency.name"
                  },
                  "value": {
                    "type": "field",
                    "bind": "@value.value"
                  }
                }
              }
            }
          ]
        },
        "damageVulnerabilities": {
          "type": "field",
          "bind": "@damage_vulnerabilities"
        },
        "damageResistances": {
          "type": "field",
          "bind": "@damage_resistances"
        },
        "damageImmunities": {
          "type": "field",
          "bind": "@damage_immunities"
        },
        "conditionImmunities": {
          "type": "pipeline",
          "source": "@condition_immunities",
          "steps": [
            {
              "step": "map",
              "item": {
                "type": "field",
                "bind": "@name"
              }
            }
          ]
        },
        "senses": {
          "type": "field",
          "bind": "@senses"
        },
        "languages": {
          "type": "field",
          "bind": "@languages"
        },
        "challengeRating": {
          "type": "field",
          "bind": "@challenge_rating"
        },
        "proficiencyBonus": {
          "type": "field",
          "bind": "@proficiency_bonus"
        },
        "xp": {
          "type": "field",
          "bind": "@xp"
        },
        "specialAbilities": {
          "type": "pipeline",
          "source": "@special_abilities",
          "steps": [
            {
              "step": "map",
              "item": {
                "type": "object",
                "fields": {
                  "name": {
                    "type": "field",
                    "bind": "@name"
                  },
                  "description": {
                    "type": "field",
                    "bind": "@desc"
                  }
                }
              }
            }
          ]
        },
        "actions": {
          "type": "pipeline",
          "source": "@actions",
          "steps": [
            {
              "step": "map",
              "item": {
                "type": "object",
                "fields": {
                  "name": {
                    "type": "field",
                    "bind": "@name"
                  },
                  "description": {
                    "type": "field",
                    "bind": "@desc"
                  }
                }
              }
            }
          ]
        },
        "legendaryActions": {
          "type": "pipeline",
          "source": "@legendary_actions",
          "steps": [
            {
              "step": "map",
              "item": {
                "type": "object",
                "fields": {
                  "name": {
                    "type": "field",
                    "bind": "@name"
                  },
                  "description": {
                    "type": "field",
                    "bind": "@desc"
                  }
                }
              }
            }
          ]
        },
        "reactions": {
          "type": "pipeline",
          "source": "@reactions",
          "steps": [
            {
              "step": "map",
              "item": {
                "type": "object",
                "fields": {
                  "name": {
                    "type": "field",
                    "bind": "@name"
                  },
                  "description": {
                    "type": "field",
                    "bind": "@desc"
                  }
                }
              }
            }
          ]
        },
        "image": {
          "type": "field",
          "bind": "@image"
        },
        "url": {
          "type": "field",
          "bind": "@url"
        }
      }
    }
  }
}
