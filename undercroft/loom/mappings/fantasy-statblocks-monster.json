{
  "type": "object",
  "$source": "fantasy-statblocks",
  "$description": "Fantasy Statblocks (Obsidian)",
  "fields": {
    "kind": {
      "type": "field",
      "bind": "='monster'"
    },
    "name": {
      "type": "field",
      "bind": "@name"
    },
    "image": {
      "type": "field",
      "bind": "@image"
    },
    "notes": {
      "type": "custom",
      "fn": "fantasyStatblockNotes"
    },
    "type": {
      "type": "custom",
      "fn": "resolveCreatureType",
      "args": {
        "path": "type"
      }
    },
    "stats": {
      "type": "with",
      "bindings": {
        "sensesObj": {
          "type": "custom",
          "fn": "fantasyStatblockSenses",
          "args": {
            "path": "senses"
          }
        },
        "hitDiceSplit": {
          "type": "custom",
          "fn": "splitHitDice",
          "args": {
            "path": "hit_dice"
          }
        }
      },
      "body": {
        "type": "object",
        "fields": {
          "size": {
            "type": "field",
            "bind": "@size"
          },
          "alignment": {
            "type": "field",
            "bind": "@alignment"
          },
          "armorClass": {
            "type": "field",
            "bind": "@ac"
          },
          "hitPoints": {
            "type": "object",
            "fields": {
              "max": {
                "type": "field",
                "bind": "@hp"
              },
              "current": {
                "type": "field",
                "bind": "@hp"
              },
              "diceString": {
                "type": "field",
                "bind": "@hitDiceSplit.roll"
              }
            }
          },
          "hitDice": {
            "type": "field",
            "bind": "@hitDiceSplit.dice"
          },
          "speed": {
            "type": "custom",
            "fn": "fantasyStatblockSpeed"
          },
          "abilities": {
            "type": "object",
            "fields": {
              "strength": {
                "type": "field",
                "bind": "@stats.0"
              },
              "dexterity": {
                "type": "field",
                "bind": "@stats.1"
              },
              "constitution": {
                "type": "field",
                "bind": "@stats.2"
              },
              "intelligence": {
                "type": "field",
                "bind": "@stats.3"
              },
              "wisdom": {
                "type": "field",
                "bind": "@stats.4"
              },
              "charisma": {
                "type": "field",
                "bind": "@stats.5"
              }
            }
          },
          "initiative": {
            "type": "object",
            "fields": {
              "bonus": {
                "type": "field",
                "bind": "=floor((@stats.1 - 10) / 2)"
              }
            }
          },
          "savingThrows": {
            "type": "custom",
            "fn": "fantasyStatblockKeyedList",
            "args": {
              "path": "saves"
            }
          },
          "skills": {
            "type": "custom",
            "fn": "fantasyStatblockKeyedList",
            "args": {
              "path": "skillsaves"
            }
          },
          "senses": {
            "type": "field",
            "bind": "@sensesObj"
          },
          "challengeRating": {
            "type": "custom",
            "fn": "formatChallengeRating",
            "args": {
              "path": "cr"
            }
          },
          "proficiencyBonus": {
            "type": "custom",
            "fn": "proficiencyBonusFromChallengeRating",
            "args": {
              "path": "cr"
            }
          },
          "proficiencies": {
            "type": "object",
            "fields": {
              "defenses": {
                "type": "custom",
                "fn": "fantasyStatblockDefenses"
              },
              "languages": {
                "type": "custom",
                "fn": "fantasyStatblockSplitList",
                "args": {
                  "path": "languages"
                }
              }
            }
          },
          "traits": {
            "type": "pipeline",
            "source": "@traits",
            "steps": [
              {
                "step": "map",
                "item": {
                  "type": "object",
                  "fields": {
                    "name": {
                      "type": "field",
                      "bind": "@name"
                    },
                    "description": {
                      "type": "field",
                      "bind": "@desc"
                    }
                  }
                }
              }
            ]
          },
          "actions": {
            "type": "pipeline",
            "source": "@actions",
            "steps": [
              {
                "step": "map",
                "item": {
                  "type": "object",
                  "fields": {
                    "name": {
                      "type": "field",
                      "bind": "@name"
                    },
                    "description": {
                      "type": "field",
                      "bind": "@desc"
                    }
                  }
                }
              }
            ]
          },
          "bonusActions": {
            "type": "pipeline",
            "source": "@bonus_actions",
            "steps": [
              {
                "step": "map",
                "item": {
                  "type": "object",
                  "fields": {
                    "name": {
                      "type": "field",
                      "bind": "@name"
                    },
                    "description": {
                      "type": "field",
                      "bind": "@desc"
                    }
                  }
                }
              }
            ]
          },
          "legendaryActions": {
            "type": "pipeline",
            "source": "@legendary_actions",
            "steps": [
              {
                "step": "map",
                "item": {
                  "type": "object",
                  "fields": {
                    "name": {
                      "type": "field",
                      "bind": "@name"
                    },
                    "description": {
                      "type": "field",
                      "bind": "@desc"
                    }
                  }
                }
              }
            ]
          },
          "reactions": {
            "type": "pipeline",
            "source": "@reactions",
            "steps": [
              {
                "step": "map",
                "item": {
                  "type": "object",
                  "fields": {
                    "name": {
                      "type": "field",
                      "bind": "@name"
                    },
                    "description": {
                      "type": "field",
                      "bind": "@desc"
                    }
                  }
                }
              }
            ]
          },
          "lairActions": {
            "type": "pipeline",
            "source": "@lair_actions",
            "steps": [
              {
                "step": "map",
                "item": {
                  "type": "object",
                  "fields": {
                    "name": {
                      "type": "field",
                      "bind": "@name"
                    },
                    "description": {
                      "type": "field",
                      "bind": "@desc"
                    }
                  }
                }
              }
            ]
          },
          "spells": {
            "type": "field",
            "bind": "@spells"
          },
          "environments": {
            "type": "custom",
            "fn": "fantasyStatblockSplitList",
            "args": {
              "path": "environment"
            }
          },
          "sources": {
            "type": "custom",
            "fn": "fantasyStatblockSources"
          }
        }
      }
    }
  }
}
