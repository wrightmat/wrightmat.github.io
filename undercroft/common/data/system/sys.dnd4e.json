    {
      "type": "array",
      "key": "races",
      "label": "Race",
      "values": [
        {
          "name": "Human",
          "description": "Adaptable, ambitious, and everywhere — humans found the greatest of the world's empires."
        },
        {
          "name": "Dwarf",
          "description": "Stout, stubborn folk of stone and stronghold, famed for resilience and grudge-keeping."
        },
        {
          "name": "Eladrin",
          "description": "Elves of the Feywild, graceful and quick to teleport short distances in the blink of an eye."
        },
        {
          "name": "Elf",
          "description": "Swift, keen-sighted wild folk of the deep forest, unmatched with a bow."
        },
        {
          "name": "Half-Elf",
          "description": "Born between two worlds, diplomatic and adaptable, at home in either."
        },
        {
          "name": "Halfling",
          "description": "Small, lucky, riverfaring folk, bold well beyond their size."
        },
        {
          "name": "Dragonborn",
          "description": "Proud, honorable dragon-descended humanoids, breathing elemental fury."
        },
        {
          "name": "Tiefling",
          "description": "Infernally-touched humanoids, self-reliant survivors of a long history of mistrust."
        }
      ]
    },
    {
      "type": "array",
      "key": "classes",
      "label": "Class",
      "values": [
        {
          "name": "Cleric",
          "role": "Leader",
          "powerSource": "Divine",
          "description": "A holy warrior-priest who channels divine power to heal allies and smite foes."
        },
        {
          "name": "Fighter",
          "role": "Defender",
          "powerSource": "Martial",
          "description": "A weapon master who locks down the battlefield and punishes anyone who looks away."
        },
        {
          "name": "Paladin",
          "role": "Defender",
          "powerSource": "Divine",
          "description": "A holy champion who marks foes and shields allies with divine power."
        },
        {
          "name": "Ranger",
          "role": "Striker",
          "powerSource": "Martial",
          "description": "A precise hunter fighting with two weapons or a bow to devastating effect."
        },
        {
          "name": "Rogue",
          "role": "Striker",
          "powerSource": "Martial",
          "description": "A cunning skirmisher who strikes hardest against an unaware or flanked foe."
        },
        {
          "name": "Warlock",
          "role": "Striker",
          "powerSource": "Arcane",
          "description": "A spellcaster bound in a pact, cursing and afflicting foes from a distance."
        },
        {
          "name": "Warlord",
          "role": "Leader",
          "powerSource": "Martial",
          "description": "A tactical commander who directs allies' actions as surely as their own."
        },
        {
          "name": "Wizard",
          "role": "Controller",
          "powerSource": "Arcane",
          "description": "A scholarly spellcaster who controls the battlefield with area magic."
        }
      ]
    },
    {
      "type": "array",
      "key": "roles",
      "label": "Role",
      "values": [
        {
          "name": "Controller",
          "description": "Dominates the battlefield with area effects and debuffs."
        },
        {
          "name": "Defender",
          "description": "Locks down enemies and punishes them for attacking anyone else."
        },
        {
          "name": "Leader",
          "description": "Heals and buffs allies, directing the party's actions."
        },
        {
          "name": "Striker",
          "description": "Deals the most single-target damage in the party."
