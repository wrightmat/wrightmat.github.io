    {
      "type": "array",
      "key": "ancestries",
      "label": "Ancestry",
      "values": [
        {
          "name": "Human",
          "description": "Adaptable and found in every corner of Golarion, humans thrive through sheer versatility."
        },
        {
          "name": "Dwarf",
          "description": "Stout and stubborn folk of stone and stronghold, famed for their resilience and craftsmanship."
        },
        {
          "name": "Elf",
          "description": "Long-lived, otherworldly folk with keen senses and a deep connection to magic."
        },
        {
          "name": "Gnome",
          "description": "Small, whimsical fey-touched people driven by an insatiable curiosity called the Bleaching."
        },
        {
          "name": "Goblin",
          "description": "Small, fire-obsessed, endlessly inventive folk often (unfairly) feared as savage pests."
        },
        {
          "name": "Halfling",
          "description": "Small, practical, lucky folk who value community, comfort, and a good meal."
        },
        {
          "name": "Leshy",
          "description": "Small plant creatures given life by primal magic, each grown from a different seed."
        },
        {
          "name": "Orc",
          "description": "Strong, resilient folk descended from the orc clans of Belkzen, thriving against harsh odds."
        },
        {
          "name": "Catfolk",
          "description": "Curious, cat-like humanoids with keen senses and a wandering streak."
        },
        {
          "name": "Gnoll",
          "description": "Hyena-like humanoids, exiled from the Mwangi Expanse, forging new lives among other folk."
        },
        {
          "name": "Hobgoblin",
          "description": "Disciplined, martial humanoids organized into tight-knit legions and warbands."
        },
        {
          "name": "Kobold",
          "description": "Small, scaly, dragon-descended folk, clever with traps and fiercely loyal to their warrens."
        },
        {
          "name": "Lizardfolk",
          "description": "Reptilian humanoids with a pragmatic, communal culture rooted in swamp and jungle."
        },
        {
          "name": "Ratfolk",
          "description": "Small, resourceful rodent-folk known for tinkering, trade, and survival instincts."
        },
        {
          "name": "Tengu",
          "description": "Bird-like humanoids, quick-witted wanderers and skilled duelists descended from tengu spirits."
        }
      ]
    },
