    {
      "type": "array",
      "key": "classes",
      "label": "Class",
      "values": [
        {
          "name": "Alchemist",
          "description": "A resourceful inventor who crafts and hurls volatile alchemical concoctions."
        },
        {
          "name": "Barbarian",
          "description": "A ferocious warrior who enters a battle-rage, trading control for overwhelming power."
        },
        {
          "name": "Bard",
          "description": "A versatile performer who weaves occult magic through music, poetry, and inspiration."
        },
        {
          "name": "Champion",
          "description": "A holy (or unholy) warrior bound by a sacred cause, wielding devotion as a weapon."
        },
        {
          "name": "Cleric",
          "description": "A divine spellcaster who channels their deity's power to heal, harm, or protect."
        },
        {
          "name": "Druid",
          "description": "A guardian of the natural order, wielding primal magic and the ability to wild shape."
        },
        {
          "name": "Fighter",
          "description": "An unmatched master of weapons and martial technique."
        },
        {
          "name": "Investigator",
          "description": "A brilliant deducer who studies a scene before acting, turning insight into advantage."
        },
        {
          "name": "Monk",
          "description": "A disciplined martial artist who channels ki through unarmed strikes and mobility."
        },
        {
          "name": "Oracle",
          "description": "A divine spellcaster whose power comes with a curse, granted without a deity's tutelage."
        },
        {
          "name": "Ranger",
          "description": "A relentless hunter and wilderness expert, precise with a chosen prey and terrain."
        },
        {
          "name": "Rogue",
          "description": "A cunning skill-monkey who strikes from an advantageous position."
        },
        {
          "name": "Sorcerer",
          "description": "An innate spellcaster whose magic flows from a bloodline rather than study."
        },
        {
          "name": "Swashbuckler",
          "description": "A flashy, daring duelist who fights with panache and style."
        },
        {
          "name": "Witch",
          "description": "A spellcaster bound in a pact to a mysterious patron, working magic through a familiar."
        },
        {
          "name": "Wizard",
          "description": "A scholarly spellcaster who studies and prepares spells from a arcane bonded book."
        }
      ]
