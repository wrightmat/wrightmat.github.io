          "name": "Blinded",
          "description": "Can't see; automatically fail sight-based checks; all terrain is difficult terrain."
        },
        {
          "name": "Broken",
          "description": "An object reduced to 0 Hit Points that still functions, but at a penalty."
        },
        {
          "name": "Clumsy",
          "description": "A status penalty (by value) to Dexterity-based rolls and DCs."
        },
        {
          "name": "Concealed",
          "description": "Hard to perceive; attacks against you have a 20% miss chance."
        },
        {
          "name": "Confused",
          "description": "Attack randomly, unable to distinguish friend from foe."
        },
        {
          "name": "Controlled",
          "description": "Another creature or GM makes your decisions for you."
        },
        {
          "name": "Dazzled",
          "description": "Concealment applies to everything due to impaired vision."
        },
        {
          "name": "Deafened",
          "description": "Can't hear; take a status penalty to Perception and auditory checks."
        },
        {
          "name": "Doomed",
          "description": "A value tracking how close to death you are from a near-fatal blow; reduces max Dying value."
        },
        {
          "name": "Drained",
          "description": "A value representing blood/vitality loss; status penalty to Constitution-based rolls."
        },
        {
          "name": "Dying",
          "description": "At 0 HP and unconscious, at risk of death; increases each failed recovery check."
        },
        {
          "name": "Encumbered",
          "description": "Carrying more Bulk than you can manage; clumsy and slowed."
        },
        {
          "name": "Enfeebled",
          "description": "A status penalty (by value) to Strength-based rolls and DCs."
        },
        {
          "name": "Fascinated",
          "description": "Fixated on something, -2 to skill checks and can't use concentrate actions on other things."
        },
        {
          "name": "Fatigued",
          "description": "Can't spend Hero Points to reroll and take a status penalty to AC and saves."
        },
        {
          "name": "Fleeing",
          "description": "Must spend actions to move away from a source of fear."
        },
        {
          "name": "Frightened",
          "description": "A value applying a status penalty to all checks and DCs, fading over time."
        },
        {
          "name": "Grabbed",
          "description": "Immobilized and flat-footed, held by another creature or effect."
        },
        {
          "name": "Immobilized",
          "description": "Cannot use any action with the move trait."
        },
        {
          "name": "Invisible",
          "description": "Cannot be seen; treated as concealed even by creatures that could otherwise see you."
        },
        {
          "name": "Paralyzed",
          "description": "Stuck in place, flat-footed, and unable to act except to Recall Knowledge."
        },
        {
          "name": "Persistent Damage",
          "description": "Ongoing damage taken at the end of each turn until it ends."
        },
        {
          "name": "Petrified",
          "description": "Turned to stone; treated as an object, immune to most effects."
        },
        {
          "name": "Prone",
          "description": "Lying on the ground; flat-footed and a penalty on attack rolls."
        },
        {
          "name": "Quickened",
          "description": "Gain one additional action each turn, usable only for specific tasks."
        },
        {
          "name": "Restrained",
          "description": "Tied up or trapped; flat-footed and unable to use move actions."
        },
        {
          "name": "Sickened",
          "description": "A value; status penalty to all checks and DCs, can't willingly ingest anything."
        },
        {
          "name": "Slowed",
          "description": "Lose a number of actions each turn equal to the condition's value."
        },
        {
          "name": "Stunned",
          "description": "Lose a number of actions, possibly all, unable to act until it fades."
        },
        {
          "name": "Stupefied",
          "description": "A status penalty (by value) to concentrate actions and mental checks/DCs."
        },
        {
          "name": "Unconscious",
          "description": "Knocked out or asleep; flat-footed, blinded, and can't act."
        },
        {
          "name": "Wounded",
          "description": "A value tracking near-death recoveries, worsening the Dying condition if it recurs."
        }
      ]
    },
