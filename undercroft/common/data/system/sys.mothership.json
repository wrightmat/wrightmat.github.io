    {
      "type": "array",
      "key": "rolls",
      "label": "Rolls",
      "values": [
        {
          "name": "Stat/Save Check (d100 Roll Under)",
          "expression": "d100",
          "resultMode": "band",
          "description": "Roll d100 against the relevant Stat or Save (plus any Skill tier bonus already added into it) — success on a result at or under it. Fired from a field's own roll button, which passes that field's current value as the target. Mothership's real critical rule (rolling DOUBLES — 11, 22, 33... — that also beats the target is a Critical Success; doubles that also fail is a Critical Failure requiring a Panic Check) isn't modeled below: it needs the roll's own two percentile digits compared to each other, which the band engine can't inspect (it only sees the final 1-100 total) — recognize doubles yourself from the rolled number.",
          "bands": [
            {
              "targetMaxFraction": 1.0,
              "label": "Success"
            },
            {
              "targetMinFraction": 0,
              "label": "Failure"
            }
          ],
          "shortName": "Check"
        },
        {
          "name": "Panic Check (2d10 + Stress)",
          "expression": "2d10+@stress.current",
          "resultMode": "band",
          "description": "Roll 2d10, add current Stress, and consult the Panic Table below. Mothership has gone through multiple printings with different exact Panic Check procedures (an earlier version used a d20 'Panic Die' roll-under-Stress instead) — this uses the 2d10+Stress version documented on the Warden's screen. The specific band thresholds below are a good-faith reconstruction from the confirmed low end (Adrenaline Rush/Nervous/Jumpy/Overwhelmed/Coward) and confirmed high end (Catatonic/Berserk/Fire) of the real table — the exact cutoffs for the middle tiers aren't sourced from the book directly, so treat them as a reasonable placeholder, not a verbatim transcription.",
          "bands": [
            {
              "max": 8,
              "label": "Adrenaline Rush — advantage on rolls, reduce Stress"
            },
            {
              "min": 9,
              "max": 10,
              "label": "Nervous — gain 1 Stress"
            },
            {
              "min": 11,
              "max": 12,
              "label": "Jumpy — gain Stress, nearby crew gain Stress too"
            },
            {
              "min": 13,
              "max": 14,
              "label": "Overwhelmed — disadvantage on rolls, Minimum Stress rises"
            },
            {
              "min": 15,
              "max": 16,
              "label": "Coward — must Fear Save to act, or flee"
            },
            {
              "min": 17,
              "max": 18,
              "label": "Spiraling Out — losing control, acting irrationally"
            },
            {
              "min": 19,
              "max": 19,
              "label": "Berserk — violent, uncontrolled outburst"
            },
            {
              "min": 20,
              "max": 21,
              "label": "Catatonic — frozen, unresponsive to everything"
            },
            {
              "min": 22,
              "label": "Total Collapse — the worst outcome; GM's call, likely permanent"
            }
          ],
          "shortName": "Panic"
        }
      ]
    }
