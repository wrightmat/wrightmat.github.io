      "values": [
        {
          "name": "Marine",
          "description": "A front-line combat specialist, trained to handle any threat with lethal efficiency — and to keep everyone else alive long enough to regret it."
        },
        {
          "name": "Android",
          "description": "A synthetic crew member, stronger and more durable than any human, and just unnerving enough that nobody ever quite forgets it."
        },
        {
          "name": "Scientist",
          "description": "A trained researcher and problem-solver, at home with data, chemistry, and the things that shouldn't exist."
        },
        {
          "name": "Teamster",
          "description": "A blue-collar spacer — pilots, mechanics, and haulers who keep the ship running, and who somehow always end up in the worst rooms."
        }
