    {
      "type": "array",
      "key": "creatureTypes",
      "label": "Creature Types",
      "values": [
        {
          "id": "aberration",
          "name": "Aberration",
          "description": "A creature whose form and thought are alien to the natural world — unsettling to look at and often incomprehensible in motive.",
          "vocabulary": { "namePatterns": ["The {name} That Should Not Be", "{name}-Thing"] },
          "traitTags": ["alien", "psionic", "unnatural"],
          "defaultSenses": ["darkvision 60 ft."],
          "defaultResistances": [],
          "defaultImmunities": []
        },
        {
          "id": "beast",
          "name": "Beast",
          "description": "A natural, non-magical animal, though often larger, fiercer, or stranger than its mundane cousins.",
          "vocabulary": { "namePatterns": ["Giant {name}", "{name} Stalker"] },
          "traitTags": ["natural", "instinctive"],
          "defaultSenses": ["keen smell or hearing"],
          "defaultResistances": [],
          "defaultImmunities": []
        },
        {
          "id": "celestial",
          "name": "Celestial",
          "description": "A creature native to the upper planes, acting (or claiming to act) with a purpose sanctioned by a greater power.",
          "vocabulary": { "namePatterns": ["{name}, Radiant Herald", "The {name}-Blessed"] },
          "traitTags": ["good-aligned", "radiant", "purposeful"],
          "defaultSenses": ["darkvision 120 ft."],
          "defaultResistances": ["radiant"],
          "defaultImmunities": []
        },
        {
          "id": "construct",
          "name": "Construct",
          "description": "An animated object or artificial body, built or shaped rather than born, following its programming or binding rather than instinct.",
          "vocabulary": { "namePatterns": ["{name} Automaton", "The {name} Engine"] },
          "traitTags": ["artificial", "mindless-or-bound"],
          "defaultSenses": ["darkvision 60 ft."],
          "defaultResistances": [],
          "defaultImmunities": ["poison", "disease", "charmed", "frightened"]
        },
        {
          "id": "dragon",
          "name": "Dragon",
          "description": "A reptilian creature of ancient, often magical lineage — proud, territorial, and rarely anyone's servant by choice.",
          "vocabulary": { "namePatterns": ["{name} the Ancient", "{name}wing"] },
          "traitTags": ["draconic", "territorial", "elemental-breath"],
          "defaultSenses": ["blindsight 30 ft.", "darkvision 120 ft."],
          "defaultResistances": [],
          "defaultImmunities": []
        },
        {
          "id": "elemental",
          "name": "Elemental",
          "description": "A creature made manifest from one of the fundamental planes of existence, acting on straightforward, often single-minded impulses.",
          "vocabulary": { "namePatterns": ["{name} of the Churn", "Living {name}"] },
          "traitTags": ["elemental-nature", "single-minded"],
          "defaultSenses": ["darkvision 60 ft."],
          "defaultResistances": [],
          "defaultImmunities": ["poison", "exhaustion"]
        },
        {
          "id": "fey",
          "name": "Fey",
          "description": "A creature tied to the vitality of nature and bound (whether it admits it or not) by old, strange rules of bargain and trickery.",
          "vocabulary": { "namePatterns": ["{name} of the Old Wood", "The {name}-Touched"] },
          "traitTags": ["fey-nature", "trickery", "bound-by-bargain"],
          "defaultSenses": ["darkvision 60 ft."],
          "defaultResistances": [],
          "defaultImmunities": []
        },
        {
          "id": "fiend",
          "name": "Fiend",
          "description": "A creature of wickedness native to (or long corrupted by) the lower planes, acting with malice and purpose.",
          "vocabulary": { "namePatterns": ["{name} of the Pit", "The {name}-Touched"] },
          "traitTags": ["evil-aligned", "fire", "cunning"],
          "defaultSenses": ["darkvision 120 ft."],
          "defaultResistances": ["fire"],
          "defaultImmunities": []
        },
        {
          "id": "giant",
          "name": "Giant",
          "description": "A humanoid-shaped creature of great size and strength, from a society with its own old, rigid sense of order.",
          "vocabulary": { "namePatterns": ["{name} the Towering", "{name}-Kin"] },
