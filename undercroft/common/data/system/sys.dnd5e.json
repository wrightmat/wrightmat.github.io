          "defaultResistances": [
            "radiant"
          ],
          "defaultImmunities": []
        },
        {
          "id": "construct",
          "name": "Construct",
          "description": "An animated object or artificial body, built or shaped rather than born, following its programming or binding rather than instinct.",
          "vocabulary": {
