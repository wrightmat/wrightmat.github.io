    {
      "type": "array",
      "key": "rolls",
      "label": "Rolls",
      "values": [
        {
          "name": "Attack Roll (d20 vs Armor Class)",
          "expression": "d20",
          "resultMode": "band",
          "description": "Roll d20. Compare to your THAC0 minus the target's Armor Class (remember: AC is DESCENDING here — a lower or negative AC is harder to hit, and effectively adds to the number needed rather than subtracting) — meeting or beating that number hits. This isn't a fixed target the roller's own targetValue mechanism can read off one field (it depends on BOTH your THAC0 and the target's own AC, worked out at the table each time), so no bands are declared below — this Move exists purely to make a d20 attack roll one click away from the Moves panel.",
          "bands": []
        },
        {
          "name": "Saving Throw (d20 Roll Under)",
          "expression": "d20",
          "resultMode": "band",
          "description": "Roll d20 against the relevant saving throw category (Death Ray or Poison, Magic Wands, Paralysis or Turn to Stone, Dragon Breath, or Rods/Staves/Spells) — meeting or beating the listed number succeeds. Fired from a save field's own roll button, which passes that save's current value as the target.",
          "bands": [
            {
              "targetMinFraction": 1.0,
              "label": "Save Succeeds"
            },
            {
              "targetMinFraction": 0,
              "label": "Save Fails"
            }
