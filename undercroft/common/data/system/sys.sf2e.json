      "label": "Ancestry",
      "values": [
        {
          "name": "Android",
          "description": "Synthetic humanoids built to mimic organic life, navigating what it means to be more than their making."
        },
        {
          "name": "Barathu",
          "description": "Amphibious, telepathic crustacean-like folk from a hive-based aquatic society."
        },
        {
          "name": "Human",
          "description": "Adaptable and widespread throughout the Pact Worlds, from Absalom Station to the frontier."
        },
        {
          "name": "Kasatha",
          "description": "Four-armed, wind-touched nomads originally from Akiton, natural void-sailors."
        },
        {
          "name": "Lashunta",
          "description": "A telepathic, matriarchal humanoid species from the jungle world of Castrovel."
        },
        {
          "name": "Pahtra",
          "description": "Feline humanoids with a strong warrior-clan tradition and keen senses."
        },
        {
          "name": "Shirren",
          "description": "Insectoid folk freed from a hive-mind, treasuring the individuality they fought to gain."
        },
        {
          "name": "Skittermander",
          "description": "Small, six-limbed, endlessly cheerful and cooperative humanoids."
        },
        {
          "name": "Vesk",
          "description": "A militaristic, reptilian warrior species whose empire rivals the Pact Worlds."
        },
        {
          "name": "Ysoki",
          "description": "Small, ratlike folk known for their curiosity, quick hands, and knack for tinkering."
        }
      ]
    },
