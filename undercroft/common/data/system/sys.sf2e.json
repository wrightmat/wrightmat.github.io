    {
      "type": "array",
      "key": "conditions",
      "label": "Conditions",
      "values": [
        {
          "name": "Blinded",
          "description": "Can't see; automatically fail sight-based checks; all terrain is difficult terrain."
        },
        {
          "name": "Broken",
          "description": "An item still functions but at a penalty, one step from destroyed."
        },
        {
          "name": "Clumsy",
          "description": "A status penalty (by value) to Dexterity-based rolls and DCs."
        },
        {
          "name": "Concealed",
          "description": "Hard to perceive; attacks against you have a 20% miss chance."
        },
        {
          "name": "Confused",
          "description": "Attack randomly, unable to distinguish friend from foe."
        },
        {
          "name": "Dazzled",
          "description": "Concealment applies to everything due to impaired vision."
        },
        {
          "name": "Deafened",
          "description": "Can't hear; status penalty to Perception and auditory checks."
        },
        {
          "name": "Doomed",
          "description": "A value tracking how close to death you are; reduces max Dying value."
        },
        {
          "name": "Drained",
          "description": "A value representing vitality loss; status penalty to Constitution-based rolls."
        },
        {
          "name": "Dying",
          "description": "At 0 Hit Points and unconscious, at risk of death."
        },
        {
          "name": "Encumbered",
          "description": "Carrying more Bulk than you can manage; clumsy and slowed."
        },
        {
          "name": "Enfeebled",
          "description": "A status penalty (by value) to Strength-based rolls and DCs."
        },
        {
          "name": "Fascinated",
          "description": "Fixated on something, -2 to skill checks, oblivious to danger."
        },
        {
          "name": "Fatigued",
          "description": "Can't spend Hero Points to reroll; status penalty to AC and saves."
        },
        {
          "name": "Fleeing",
          "description": "Must spend actions to move away from a source of fear."
        },
        {
          "name": "Frightened",
          "description": "A value applying a status penalty to all checks and DCs, fading over time."
        },
        {
          "name": "Grabbed",
          "description": "Immobilized and flat-footed, held by another creature or effect."
        },
        {
          "name": "Immobilized",
          "description": "Cannot use any action with the move trait."
        },
        {
          "name": "Invisible",
          "description": "Cannot be seen; treated as concealed even by creatures that could otherwise see you."
        },
        {
          "name": "Off-Kilter",
          "description": "Off-balance; flat-footed and unable to take reactions."
        },
        {
          "name": "Paralyzed",
          "description": "Stuck in place, flat-footed, unable to act except to Recall Knowledge."
        },
        {
          "name": "Persistent Damage",
          "description": "Ongoing damage taken at the end of each turn until it ends."
        },
        {
          "name": "Prone",
