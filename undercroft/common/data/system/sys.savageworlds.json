    {
      "type": "array",
      "key": "rolls",
      "label": "Rolls",
      "values": [
        {
          "name": "Trait Roll (d4, Wild Die)",
          "expression": "max(d4!,d6!)",
          "resultMode": "band",
          "description": "Roll a d4 (the trait's own die) and a d6 (the Wild Die) together, both Acing (exploding on their own max face), and take the higher single result — this is exactly what happens at the table, not an approximation. 4+ is a Success; every 4 over that is a Raise. A non-Wild-Card (an Extra) skips the Wild Die entirely and just rolls the plain d4 — use the standalone d4 quick-dice button for that instead of this Move.",
          "bands": [
            {
              "min": 16,
              "label": "Success with 3 Raises"
            },
            {
              "min": 12,
              "max": 15,
              "label": "Success with 2 Raises"
            },
            {
              "min": 8,
              "max": 11,
              "label": "Success with 1 Raise"
            },
            {
              "min": 4,
              "max": 7,
              "label": "Success"
            },
            {
              "max": 3,
              "label": "Failure"
            }
          ],
          "shortName": "d4Trait"
        },
