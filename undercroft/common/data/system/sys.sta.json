      "key": "species",
      "label": "Species",
      "values": [
        {
          "name": "Human",
          "description": "Adaptable and endlessly curious, humans make up the largest single population within Starfleet."
        },
        {
          "name": "Vulcan",
          "description": "Devoted to logic and the suppression of emotion, descended from a people who nearly destroyed themselves through passion."
        },
        {
          "name": "Andorian",
          "description": "A fierce, blue-skinned, antennaed people from a frozen moon, quick to anger and fiercely loyal."
        },
        {
          "name": "Betazoid",
          "description": "A telepathic people from Betazed, able to sense (and sometimes read) the thoughts and feelings of others."
        },
        {
          "name": "Bajoran",
          "description": "A deeply spiritual people who endured decades of Cardassian Occupation before joining the Federation."
        },
        {
          "name": "Trill",
          "description": "A humanoid people, some of whom carry a symbiont — a joined lifetime of memory spanning many past hosts."
        },
        {
          "name": "Tellarite",
          "description": "A blunt, argumentative people who consider vigorous debate a sign of respect, not hostility."
        },
        {
          "name": "Klingon",
          "description": "A proud warrior culture bound by honor and the Klingon Empire's own code of glory in battle and death."
        },
        {
          "name": "Denobulan",
          "description": "A gregarious, extroverted people from a world of unusual, harmonious social and family structures."
        },
        {
          "name": "Bolian",
          "description": "A cheerful, blue-skinned people known throughout the Federation for sociability and administrative skill."
        }
      ]
    },
