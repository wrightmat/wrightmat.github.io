    {
      "type": "array",
      "key": "rolls",
      "label": "Rolls",
      "values": [
        {
          "name": "Task Roll (2d20)",
          "expression": "2d20t<=@targetNumber",
          "resultMode": "band",
          "description": "Roll 2d20 and tally how many come in at or under this task's Target Number (an Attribute + a Discipline, e.g. Security + Control to fire a phaser — filled into the Current Task's Target Number field above before rolling, since which pair applies changes with every task, unlike CoC/GURPS's fixed per-field targets). Compare the tally below to the Difficulty (1-5 successes) the GM called for the task — that comparison isn't automated here since Difficulty is scene-specific, not character data, the same limitation Fate Core's own Move flags. Two further real rules aren't modeled: a natural 1 counts as 2 successes rather than 1 (the tally engine counts hits, not weighted hits), and a natural 20 triggers a Complication (the tally engine reports successes against ONE threshold per roll, not a second, independent natural-20 check) — read the individual die results in the roll's own breakdown and apply both by hand.",
          "bands": [
            {
              "tally": {
                "gte": 2
              },
              "label": "2 Successes — bonus Momentum generated"
            },
            {
              "tally": {
                "eq": 1
              },
              "label": "1 Success"
            },
            {
              "tally": {
                "eq": 0
              },
              "label": "0 Successes — Failure"
            }
          ]
        }
      ]
    }
