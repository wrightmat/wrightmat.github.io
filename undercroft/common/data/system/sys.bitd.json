    {
      "type": "array",
      "key": "vices",
      "label": "Vice",
      "values": [
        {
          "name": "Faith",
          "description": "Praying, ceremonies to old gods, seeking the miraculous, spiritual devotion."
        },
        {
          "name": "Gambling",
          "description": "Betting on fights, racing, cards, dice, and other games of chance."
        },
        {
          "name": "Luxury",
          "description": "Fine clothes, food, drink, drugs, and other indulgent pleasures."
        },
        {
          "name": "Obligation",
          "description": "Fulfilling the needs of your friends, family, or associates."
        },
        {
          "name": "Pleasure",
          "description": "Hedonistic thrills, carnal pleasures, ecstatic worship."
        },
        {
          "name": "Stupor",
          "description": "Drinking, drugs, and other means of numbing oneself."
        },
        {
          "name": "Weird",
          "description": "Occult knowledge, forbidden lore, communion with spirits."
        }
      ]
    },
    {
      "type": "object",
      "key": "playbooks",
      "label": "Playbook",
      "children": [
        {
          "type": "array",
          "key": "playbooks.cutter",
          "label": "Cutter",
          "values": [
            {
              "name": "Bodyguard",
              "description": "When you take Harm meant for an ally, reduce it by one level."
            },
            {
              "name": "Battleborn",
              "description": "You don't suffer the effects of lesser or moderate harm until the engagement ends."
            },
            {
              "name": "Not to Be Trifled With",
              "description": "When you take a moment to intimidate someone, roll Command; they must Resist with a worse position."
            }
          ]
        },
        {
          "type": "array",
          "key": "playbooks.hound",
          "label": "Hound",
          "values": [
            {
              "name": "Ghost",
              "description": "You may move like a ghost, undetected by normal means, when you Prowl."
            },
            {
              "name": "Mule",
              "description": "You may carry Heavy Load without penalty, and a Normal Load counts as Light."
            },
            {
              "name": "Trueblade",
              "description": "Your ranged attacks with a bow or firearm gain increased range and precision."
            }
          ]
        },
        {
          "type": "array",
          "key": "playbooks.leech",
          "label": "Leech",
          "values": [
            {
              "name": "Turtle",
              "description": "When you Set Up to defend yourself or an ally, take +1d."
            },
            {
              "name": "Alchemist",
              "description": "You can whip up alchemical solutions to most any problem, given time and materials."
            },
            {
              "name": "Sawbones",
              "description": "You're an exceptional physician. When you Tinker to heal someone, take +1d."
            }
          ]
        },
        {
          "type": "array",
          "key": "playbooks.lurk",
          "label": "Lurk",
          "values": [
            {
              "name": "Ghost",
              "description": "You may move like a ghost, undetected by normal means, when you Prowl."
            },
            {
              "name": "Shadow",
              "description": "While in dim light or darkness, you may become practically invisible."
            },
            {
              "name": "Vigor",
              "description": "You may push yourself without marking harm; ignore the effects of exhaustion."
            }
          ]
        },
        {
          "type": "array",
          "key": "playbooks.slide",
          "label": "Slide",
          "values": [
            {
              "name": "Ghost Tongue",
              "description": "You know the language of ghosts and spirits and can speak with them."
            },
            {
              "name": "Cloak & Dagger",
              "description": "You have a knack for saying just the right thing in a lie. Take +1d when you Sway to deceive."
            },
            {
              "name": "Mind's Order",
              "description": "You have iron self-control. You can resist mental and emotional intrusions with Resolve instead of Insight."
            }
          ]
        },
        {
          "type": "array",
          "key": "playbooks.spider",
          "label": "Spider",
          "values": [
            {
              "name": "Foresight",
              "description": "At the start of each session, take 2 stress and ask the GM one question about an upcoming challenge."
            },
            {
              "name": "Rated Ability",
              "description": "Choose one action rating (up to 2 dots): Command, Consort, or Sway. Increase it by one."
            },
            {
              "name": "Iron Will",
              "description": "You may resist harm and fear with Resolve, adding your Tier to the roll."
            }
          ]
        },
        {
          "type": "array",
          "key": "playbooks.whisper",
          "label": "Whisper",
          "values": [
            {
              "name": "Ritualist",
              "description": "You know rites and rituals that allow you to channel supernatural power."
            },
            {
              "name": "Ghost Contract",
              "description": "You've formed a pact with a ghost, granting you access to its power."
            },
            {
              "name": "Eerie",
              "description": "There's something deeply unsettling about you. Take +1d when you Consort or Sway to intimidate through the uncanny."
            }
          ]
        }
      ]
    },
