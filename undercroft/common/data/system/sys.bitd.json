    {
      "type": "array",
      "key": "generalCrewUpgrades",
      "label": "General Crew Upgrade",
      "values": [
        {
          "name": "Carriage House",
          "description": "A carriage, draft animals, and a stable. A second upgrade adds armor and larger, swifter steeds."
        },
        {
          "name": "Boat House",
          "description": "A boat, a dock, and a small shack for boating supplies. A second upgrade adds armor and more cargo capacity."
        },
        {
          "name": "Hidden Lair",
          "description": "Your lair's location is disguised. If discovered, spend 2 downtime activities and coin equal to your Tier to relocate and hide it again."
        },
        {
          "name": "Quarters",
          "description": "Your lair includes living quarters for the crew. Without this, each PC sleeps elsewhere and is vulnerable when they do."
        },
        {
          "name": "Secure Lair",
          "description": "Your lair has locks, alarms, and traps. A second upgrade adds arcane defenses that work against spirits."
        },
        {
          "name": "Vault",
          "description": "A secure vault, increasing coin storage to 8. A second upgrade increases capacity to 16."
        },
        {
          "name": "Workshop",
          "description": "A workshop for tinkering and alchemy, plus a small library — accomplish long-term projects without leaving your lair."
        },
        {
          "name": "Mastery",
          "description": "Access to master-level training. Advance PCs' action ratings to 4 (capped at 3 otherwise). Costs four upgrade boxes to unlock."
        },
        {
          "name": "Quality: Documents",
