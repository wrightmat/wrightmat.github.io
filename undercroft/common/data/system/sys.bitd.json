      "values": [
        {
          "name": "Cold",
          "description": "You are unable to connect emotionally with other people."
        },
        {
          "name": "Haunted",
          "description": "You're bothered by disturbing thoughts or visions."
        },
        {
          "name": "Obsessed",
          "description": "You're consumed by a fixation. Difficult to focus on anything else."
        },
        {
          "name": "Paranoid",
          "description": "You imagine danger everywhere. You can't trust others."
        },
        {
          "name": "Reckless",
          "description": "You have little regard for your own safety or best interests."
        },
        {
          "name": "Soft",
          "description": "You lose your edge. Compassion overwhelms you."
        },
        {
          "name": "Unstable",
          "description": "Your emotional state is volatile. Trifles enrage you."
        },
        {
          "name": "Vicious",
          "description": "You seek out opportunities to hurt people, even for no good reason."
        }
