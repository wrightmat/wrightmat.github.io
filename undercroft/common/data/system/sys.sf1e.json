    {
      "type": "array",
      "key": "races",
      "label": "Race",
      "values": [
        {
          "name": "Android",
          "description": "Synthetic humanoids built to mimic organic life, emotionless in appearance but not in truth."
        },
        {
          "name": "Human",
          "description": "Adaptable and widespread, humans settled the Pact Worlds after the Gap as readily as they did Golarion."
        },
        {
          "name": "Kasatha",
          "description": "Four-armed, wind-touched nomads from the desert world of Castrovel's twin, Akiton."
        },
        {
          "name": "Lashunta",
          "description": "A telepathic, matriarchal humanoid species from the jungle world of Castrovel."
        },
        {
          "name": "Shirren",
          "description": "Insectoid folk freed from a hive-mind, prizing the individuality they fought to gain."
        },
        {
          "name": "Vesk",
          "description": "A militaristic, reptilian warrior species whose empire rivals the Pact Worlds."
        },
        {
          "name": "Ysoki",
          "description": "Small, ratlike folk known for their curiosity, quick hands, and knack for tinkering."
        }
      ]
    },
    {
      "type": "array",
      "key": "classes",
      "label": "Class",
      "values": [
        {
          "name": "Envoy",
          "description": "A social specialist who inspires allies and manipulates the battlefield with words."
        },
        {
          "name": "Mechanic",
          "description": "A tech expert who fields a combat drone or exocortex and bypasses systems with ease."
        },
        {
          "name": "Mystic",
          "description": "A spellcaster who draws on mystical connections rather than technology or study."
        },
        {
          "name": "Operative",
          "description": "A precise specialist who relies on skill, stealth, and a lethal trick attack."
        },
        {
          "name": "Solarian",
          "description": "A warrior attuned to stellar forces, channeling the power of stars and gravity."
        },
        {
          "name": "Soldier",
          "description": "A frontline combatant trained in a wide range of weapons and combat styles."
        },
        {
          "name": "Technomancer",
          "description": "A spellcaster who fuses magic and technology into a unique hybrid discipline."
        }
      ]
    },
