      "label": "Conditions",
      "values": [
        {
          "name": "Bleeding",
          "description": "Takes ongoing damage each round until healed or treated."
        },
        {
          "name": "Blinded",
          "description": "Cannot see; takes penalties to most Str/Dex-based tasks and loses Dex bonus to AC."
        },
        {
          "name": "Broken",
          "description": "An item still functions but at a penalty, one step from being destroyed."
        },
        {
          "name": "Burning",
          "description": "Takes ongoing fire damage each round until the flames are put out."
        },
        {
          "name": "Confused",
          "description": "Acts randomly, determined by die roll each round."
        },
        {
          "name": "Cowering",
          "description": "Frozen in fear; flat-footed and can take no actions."
        },
        {
          "name": "Dazzled",
          "description": "-1 on attack rolls; cannot make out fine details."
        },
        {
          "name": "Dead",
          "description": "The character's life has ended."
        },
        {
          "name": "Deafened",
          "description": "Automatic failure on hearing-based checks, -4 on initiative."
        },
        {
          "name": "Dying",
          "description": "Unconscious and losing Stamina/Hit Points each round until stabilized."
        },
        {
          "name": "Encumbered",
          "description": "Carrying more bulk than allowed; penalties to physical checks and speed."
        },
        {
          "name": "Entangled",
          "description": "-2 on attack rolls, -4 Dexterity, movement restricted."
        },
        {
          "name": "Exhausted",
          "description": "Move at half speed, -6 penalty to Str and Dex."
        },
        {
          "name": "Fascinated",
          "description": "Fixated on a source, oblivious to danger, -4 to skill checks."
        },
        {
          "name": "Fatigued",
          "description": "Cannot run or charge, -2 penalty to Str and Dex."
        },
        {
          "name": "Flat-Footed",
          "description": "Loses Dex bonus to AC and can't make attacks of opportunity."
        },
        {
          "name": "Frightened",
          "description": "Must flee; penalties to attacks, saves, skills, and ability checks."
        },
        {
          "name": "Grappled",
          "description": "Restrained by another creature or effect; limited actions."
        },
        {
          "name": "Nauseated",
          "description": "Can only take a single move action each round."
        },
        {
          "name": "Off-Kilter",
          "description": "Unique Starfinder condition — flat-footed and can't take reactions."
        },
        {
          "name": "Paralyzed",
          "description": "Frozen in place, unable to act, loses Dex bonus to AC."
        },
        {
          "name": "Pinned",
          "description": "Grappled and held immobile with further AC penalties."
        },
        {
          "name": "Prone",
          "description": "Lying on the ground; penalties to melee attacks, bonus AC vs ranged."
        },
        {
          "name": "Shaken",
          "description": "Penalty on attack rolls, saves, skills, and ability checks."
        },
        {
          "name": "Sickened",
          "description": "Penalty on attack rolls, damage, saves, skills, and ability checks."
        },
        {
          "name": "Staggered",
          "description": "May take only a single move or standard action each round."
        },
        {
