    {
      "type": "array",
      "key": "races",
      "label": "Race",
      "values": [
        {
          "name": "Human",
          "description": "Adaptable and ambitious, humans settle every corner of the world and adapt to any culture."
        },
        {
          "name": "Dwarf",
          "description": "Stout, stubborn folk of stone and stronghold, famed for resilience and grudge-keeping."
        },
        {
          "name": "Elf",
          "description": "Long-lived, graceful folk with keen senses and an affinity for magic and the bow."
        },
        {
          "name": "Gnome",
          "description": "Small, curious tinkerers and illusionists with a fondness for humor and small magics."
        },
        {
          "name": "Half-Elf",
          "description": "Born between two worlds, adaptable but rarely fully accepted by either."
        },
        {
          "name": "Half-Orc",
          "description": "Born of two worlds that rarely accept them fully, strong and often hard-bitten."
        },
        {
          "name": "Halfling",
          "description": "Small, practical, lucky folk who value community, comfort, and a good meal."
        }
      ]
    },
    {
      "type": "array",
      "key": "classes",
      "label": "Class",
      "values": [
        {
          "name": "Barbarian",
          "description": "A savage warrior who rages in battle, trading defense for raw destructive power."
        },
        {
          "name": "Bard",
          "description": "A jack-of-all-trades performer who weaves arcane magic through music and inspiration."
        },
        {
          "name": "Cleric",
          "description": "A divine spellcaster empowered by a deity, channeling positive or negative energy."
        },
        {
          "name": "Druid",
          "description": "A guardian of the natural world who commands nature magic and can wild shape."
        },
        {
          "name": "Fighter",
          "description": "A master of weapons and armor, relying on training and raw combat prowess."
        },
        {
          "name": "Monk",
          "description": "A disciplined martial artist who channels inner power through unarmed combat and mobility."
        },
        {
          "name": "Paladin",
          "description": "A holy warrior bound by a sacred code, wielding divine magic in service of justice."
        },
        {
          "name": "Ranger",
          "description": "A skilled hunter and wilderness expert with a favored enemy and terrain."
        },
        {
          "name": "Rogue",
          "description": "A cunning opportunist who strikes from the shadows and relies on skill over brute force."
        },
        {
          "name": "Sorcerer",
          "description": "An innate spellcaster whose magic flows from bloodline rather than study."
        },
        {
          "name": "Wizard",
          "description": "A scholarly spellcaster who prepares spells from a memorized spellbook."
        }
      ]
    },
