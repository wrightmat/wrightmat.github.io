      "label": "Conditions",
      "values": [
        {
          "name": "Blinded",
          "description": "Cannot see; -2 AC, loses Dex bonus to AC, -4 to most Str/Dex-based checks."
        },
        {
          "name": "Confused",
          "description": "Acts randomly, determined by die roll each round."
        },
        {
          "name": "Cowering",
          "description": "Frozen in fear; loses Dex bonus to AC, can take no actions."
        },
        {
          "name": "Dazed",
          "description": "Can take no actions, but has no penalty to AC."
        },
        {
          "name": "Dazzled",
          "description": "-1 on attack rolls; cannot precisely make out details."
