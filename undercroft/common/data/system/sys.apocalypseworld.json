      "label": "Player Name"
    },
    {
      "type": "array",
      "key": "playbooks",
      "label": "Playbook",
      "values": [
        {
          "name": "Angel",
          "description": "A field medic with a piece of scavenged pre-apocalypse medical tech, holding life and death in their hands."
        },
        {
          "name": "Battlebabe",
          "description": "Impossibly dangerous and impossibly stylish, armed and armored beyond all reasonable sense."
        },
        {
          "name": "Brainer",
          "description": "A psychic who can open minds, plant thoughts, and take what isn't offered."
        },
        {
          "name": "Chopper",
          "description": "The chief of a biker gang, riding hard with a crew that lives and dies by their word."
        },
        {
          "name": "Driver",
          "description": "The keeper of a garage full of vehicles, and the best driver anyone around has ever seen."
        },
        {
          "name": "Gunlugger",
          "description": "A walking arsenal — when the fighting starts, this is who you want on your side."
        },
        {
          "name": "Hardholder",
          "description": "The boss of a hardhold, ruling over gangers and a population that depends on them for survival."
        },
        {
          "name": "Hocus",
          "description": "The leader of a following, part cult leader and part shepherd, wielding belief as a weapon."
        },
        {
          "name": "Maestro D'",
          "description": "The keeper of the world's fanciest surviving establishment, offering luxury in the wasteland."
        },
        {
          "name": "Savvyhead",
          "description": "A tinkerer and inventor, keeper of a workspace full of half-understood pre-apocalypse tech."
        },
        {
          "name": "Skinner",
          "description": "Devastatingly attractive and devastatingly aware of it, trading beauty for leverage."
        }
      ]
    },
