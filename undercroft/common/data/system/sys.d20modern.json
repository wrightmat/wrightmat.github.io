    {
      "type": "array",
      "key": "occupations",
      "label": "Starting Occupation",
      "values": [
        {
          "name": "Academic",
          "description": "Librarians, archaeologists, and scholars — a life spent in research and study."
        },
        {
          "name": "Adventurer",
          "description": "Professional daredevils, big-game hunters, and treasure seekers who live for the next expedition."
        },
        {
          "name": "Athlete",
          "description": "A professional or amateur competitor whose training has honed body and reflexes alike."
        },
        {
          "name": "Blue Collar",
          "description": "Tradespeople and laborers — mechanics, electricians, construction workers — who know how things actually get built and fixed."
        },
        {
          "name": "Celebrity",
          "description": "Someone famous, for better or worse — an actor, musician, or public figure whose name opens doors."
        },
        {
          "name": "Creative",
          "description": "Artists, writers, and performers who make a living from imagination."
        },
        {
          "name": "Criminal",
          "description": "Someone who's lived on the wrong side of the law — a thief, a con artist, or worse."
        },
        {
          "name": "Dilettante",
          "description": "Independently wealthy, with no need to work — free to pursue whatever catches their interest."
        },
        {
          "name": "Doctor",
          "description": "A physician, surgeon, or psychiatrist trained to heal the human body and mind."
        },
        {
          "name": "Emergency Services",
          "description": "Firefighters, paramedics, and first responders trained to run toward danger, not away from it."
        },
        {
          "name": "Entrepreneur",
          "description": "A business owner who built something from nothing, and knows how to make a deal."
        },
        {
          "name": "Investigative",
          "description": "Private investigators and journalists who dig for the truth others would rather stayed buried."
        },
        {
          "name": "Law Enforcement",
          "description": "Police officers and detectives sworn to uphold the law."
        },
        {
          "name": "Military",
          "description": "Trained soldiers, veterans of a service branch, disciplined in combat and command."
        },
        {
          "name": "Religious",
          "description": "Clergy and the devout, whose calling shapes how they see the world."
        },
        {
          "name": "Rural",
          "description": "Farmers, ranchers, and small-town folk with practical, hands-on know-how."
        },
        {
          "name": "Student",
          "description": "Still in school — high school, college, or graduate study — with a major field in mind."
        },
        {
          "name": "Technician",
          "description": "Engineers, programmers, and IT professionals fluent in the machinery of the modern world."
        },
        {
          "name": "White Collar",
          "description": "Office professionals — accountants, lawyers, managers — who navigate institutions for a living."
        }
      ]
    },
    {
      "type": "array",
      "key": "classes",
      "label": "Basic Class",
      "values": [
        {
          "name": "Strong Hero",
          "description": "Trained in athletic endeavors and raw physical power — excels at melee combat and feats of Strength."
        },
        {
          "name": "Fast Hero",
          "description": "Trained in agility, hand-eye coordination, and reflexes — excels at ranged combat and getting out of the way."
        },
        {
          "name": "Tough Hero",
          "description": "Improved physical fitness, health, and stamina — built to take a hit and keep standing."
        },
        {
          "name": "Smart Hero",
          "description": "Improved reasoning and applied knowledge — research, technology, and outthinking the opposition."
        },
        {
          "name": "Dedicated Hero",
          "description": "A devotion to a cause, an ideal, or a higher purpose — investigative, empathic, healing, and spiritual talents."
        },
        {
          "name": "Charismatic Hero",
          "description": "Training in winning friends and influencing people — a leader, a celebrity, a con artist, or a flirt."
        }
      ]
    },
    {
      "type": "array",
      "key": "advancedClasses",
      "label": "Advanced Class",
      "values": [
        {
          "name": "Soldier",
          "description": "A trained military combatant, disciplined in weapons, tactics, and teamwork."
        },
        {
          "name": "Martial Artist",
          "description": "A master of unarmed and melee combat, striking with speed and precision."
        },
        {
          "name": "Gunslinger",
          "description": "A firearms specialist whose speed and accuracy with a gun border on legend."
        },
        {
          "name": "Daredevil",
          "description": "A death-defying stunt performer who pushes body and luck past their limits."
        },
        {
          "name": "Bodyguard",
          "description": "A protector, trained to keep someone else alive at any cost."
        },
        {
          "name": "Field Scientist",
          "description": "A researcher who applies hard science under real-world pressure."
        },
        {
          "name": "Techie",
          "description": "A builder and hacker who can jury-rig, repair, or improve almost any piece of technology."
        },
        {
          "name": "Field Medic",
          "description": "A combat medic, trained to keep people alive when the nearest hospital is nowhere close."
        },
        {
          "name": "Investigator",
          "description": "A detective who reads a scene, a suspect, and a lie better than anyone else in the room."
        },
        {
          "name": "Negotiator",
          "description": "A master of leverage, persuasion, and the art of getting what they want from people."
        }
      ]
    },
