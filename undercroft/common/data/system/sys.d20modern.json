          "name": "Panicked",
          "description": "Must drop items and flee; -2 on attack rolls, saves, skills."
        },
        {
          "name": "Paralyzed",
          "description": "Frozen in place, cannot act, loses Dex bonus to Defense."
        },
        {
          "name": "Pinned",
          "description": "Held immobile (but not helpless) in a grapple by a superior opponent."
        },
        {
          "name": "Prone",
