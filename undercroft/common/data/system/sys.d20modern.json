    {
      "type": "array",
      "key": "conditions",
      "label": "Conditions",
      "values": [
        {
          "name": "Ability Damaged",
          "description": "A temporary reduction to an ability score, recovered through natural healing."
        },
        {
          "name": "Ability Drained",
          "description": "A permanent reduction to an ability score, only restored by extraordinary means."
        },
        {
          "name": "Blinded",
          "description": "Cannot see; -2 to Defense, loses Dex bonus to Defense, -4 on most Str/Dex-based checks."
        },
        {
          "name": "Cowering",
          "description": "Frozen in fear; loses Dex bonus to Defense, can take no actions."
        },
        {
          "name": "Dazed",
          "description": "Can take no actions, but has no penalty to Defense."
        },
        {
          "name": "Dead",
          "description": "Character has died from massive damage or accumulated wounds."
        },
        {
          "name": "Deafened",
          "description": "-4 on initiative, automatic failure on hearing-based checks."
        },
        {
          "name": "Disabled",
          "description": "At exactly 0 hit points; can take a single move or attack action each round, but a standard action deals 1 point of damage afterward."
        },
        {
          "name": "Dying",
          "description": "At negative hit points and unstable, losing 1 hit point per round until stabilized."
        },
        {
          "name": "Entangled",
          "description": "-2 on attack rolls, -4 Dexterity, can only move at half speed."
        },
        {
          "name": "Exhausted",
          "description": "Moves at half speed, -6 penalty to Str and Dex."
        },
        {
          "name": "Fatigued",
          "description": "Cannot run or charge, -2 penalty to Str and Dex."
        },
        {
          "name": "Flat-Footed",
          "description": "Loses Dex bonus to Defense, cannot make attacks of opportunity."
        },
        {
          "name": "Grappled",
          "description": "Restrained by another; limited actions, no free movement."
        },
