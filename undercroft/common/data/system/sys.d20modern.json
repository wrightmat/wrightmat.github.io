        },
        {
          "name": "Stable",
          "description": "No longer losing hit points, but still unconscious at negative hit points until recovering."
        },
        {
          "name": "Stunned",
          "description": "Drops everything held, can't act, loses Dex bonus to Defense."
        },
        {
          "name": "Unconscious",
          "description": "Knocked out or asleep; helpless."
