    {
      "type": "array",
      "key": "rolls",
      "label": "Rolls",
      "values": [
        {
          "name": "Skill / Characteristic Check (d100, Roll Under)",
          "expression": "d100",
          "resultMode": "band",
          "description": "Roll d100 against the skill or characteristic being tested. Fired from a field's own roll button (a Skill's % input, a Characteristic score), which passes that field's current value through as the target — Regular/Hard/Extreme success, and the conditional 96-99 Fumble, are evaluated live against it. Fired from the Moves panel with no associated field, only the two fixed thresholds (Critical Success on a 1, Fumble on 100) can match.",
          "bands": [
            {
              "max": 1,
              "label": "Critical Success"
            },
            {
              "min": 100,
              "max": 100,
              "label": "Fumble"
            },
            {
              "min": 96,
              "max": 99,
              "targetBelow": 50,
              "label": "Fumble"
            },
            {
              "targetMaxFraction": 0.2,
              "label": "Extreme Success"
            },
            {
              "targetMaxFraction": 0.5,
              "label": "Hard Success"
            },
            {
              "targetMaxFraction": 1.0,
              "label": "Regular Success"
            },
            {
              "targetMinFraction": 0,
              "label": "Failure"
            }
          ],
          "shortName": "Skill"
        },
        {
          "name": "Luck Regain (Optional, d100 Roll Over)",
          "shortName": "Luck",
          "expression": "d100",
          "resultMode": "band",
          "description": "Optional rule: roll d100 against your current Luck. Rolling OVER your current Luck regains it to a new (usually higher) rolled value.",
          "bands": [
            {
              "targetExceeds": true,
              "label": "Luck Regained"
            },
            {
              "targetMinFraction": 0,
              "label": "No Change"
            }
          ]
        }
      ]
    },
