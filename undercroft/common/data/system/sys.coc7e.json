    {
      "type": "array",
      "key": "derivedFormulas",
      "label": "Derived Formulas",
      "values": [
        {
          "role": "hitPoints",
          "formula": "floor((@size + @constitution) / 10)",
          "name": "hitPoints"
        },
        {
          "role": "magicPoints",
          "formula": "floor(@power / 5)",
          "name": "magicPoints"
        },
        {
          "role": "sanityStart",
          "formula": "@power",
          "name": "sanityStart"
        },
        {
          "role": "moveRate",
          "formula": "if(and(@strength < @size, @dexterity < @size), 7, if(and(@strength > @size, @dexterity > @size), 9, 8))",
          "name": "moveRate"
        }
      ]
    },
