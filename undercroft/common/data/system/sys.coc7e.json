    {
      "type": "array",
      "key": "conditions",
      "label": "Conditions",
      "values": [
        {
          "name": "Temporary Insanity",
          "description": "A sudden, bounded bout of madness triggered by a Sanity loss of 5 or more in a single round."
        },
        {
          "name": "Indefinite Insanity",
          "description": "A longer psychological break triggered by losing 1/5 or more of current Sanity in a single check."
        },
        {
          "name": "Major Wound",
          "description": "A single injury dealing damage equal to or exceeding half of the investigator's maximum Hit Points."
        },
        {
          "name": "Unconscious",
          "description": "Unable to act; falls when Hit Points reach 0, or by other incapacitating effects."
        },
        {
          "name": "Dying",
          "description": "Hit Points at 0 or below without immediate first aid or medical treatment."
        },
        {
          "name": "Bleeding Out",
          "description": "Losing Hit Points each round until stabilized."
        },
        {
          "name": "Prone",
          "description": "Knocked down; at a disadvantage until standing back up."
        },
        {
          "name": "Grappled",
          "description": "Held and restrained by an opponent or creature."
        },
        {
          "name": "Blinded",
          "description": "Unable to see; automatic failure on sight-based checks."
        },
        {
          "name": "Deafened",
          "description": "Unable to hear; automatic failure on hearing-based checks."
        },
        {
          "name": "Poisoned",
          "description": "Suffering the ongoing effects of a toxin."
        }
      ]
    },
    {
      "type": "array",
      "key": "madnessSymptoms",
      "label": "Bouts of Madness",
      "values": [
        {
          "name": "Amnesia",
          "description": "The investigator loses all memory of events since the trauma, sometimes longer."
        },
        {
          "name": "Paranoia",
          "description": "Overwhelming, irrational mistrust of others, even close allies."
        },
        {
          "name": "Phobia",
          "description": "A specific, intense, irrational fear takes hold."
        },
        {
          "name": "Mania",
