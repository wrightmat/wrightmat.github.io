{
  "id": "srd-spell-card",
  "title": "5e API Spell Card",
  "category": "print",
  "description": "Single spell card populated directly from a 5e API spell lookup (raw response fields).",
  "type": "card",
  "formats": [
    {
      "id": "letter",
      "label": "US Letter",
      "sizeId": "letter",
      "orientations": [
        "portrait",
        "landscape"
      ],
      "defaultOrientation": "portrait"
    },
    {
      "id": "a4",
      "label": "A4",
      "sizeId": "a4",
      "orientations": [
        "portrait",
        "landscape"
      ],
      "defaultOrientation": "portrait"
    }
  ],
  "supportedSources": [
    "srd"
  ],
  "card": {
    "width": 2.5,
    "height": 3.5,
    "gutter": 0,
    "safeInset": 0.125,
    "bleed": 0.125,
    "columns": 1,
    "rows": 1
  },
  "pages": {
    "front": {
      "repeat": "@",
      "layout": {
        "type": "stack",
        "gap": 4,
        "children": [
          {
            "type": "row",
            "gap": 2,
            "columns": [
              {
                "node": {
                  "type": "field",
                  "component": "text",
                  "text": "@school.name",
                  "className": "card-meta"
                }
              },
              {
                "node": {
                  "type": "field",
                  "component": "text",
                  "text": "@level",
                  "className": "card-meta text-end"
                }
              }
            ]
          },
          {
            "type": "field",
            "component": "text",
            "text": "@name",
            "className": "card-title",
            "textSize": "lg",
            "textStyles": {
              "bold": true
            }
          },
          {
            "type": "row",
            "gap": 2,
            "columns": [
              {
                "node": {
                  "type": "field",
                  "component": "text",
                  "text": "@casting_time",
                  "className": "card-meta"
                }
              },
              {
                "node": {
                  "type": "field",
                  "component": "text",
                  "text": "@range",
                  "className": "card-meta text-end"
                }
              }
            ]
          },
          {
            "type": "row",
            "gap": 2,
            "columns": [
              {
                "node": {
                  "type": "field",
                  "component": "text",
                  "text": "@duration",
                  "className": "card-meta"
                }
              },
              {
                "node": {
                  "type": "field",
                  "component": "text",
                  "text": "@components",
                  "className": "card-meta text-end"
                }
              }
            ]
          },
          {
            "type": "field",
            "component": "text",
            "text": "@desc.0",
            "className": "card-body-text"
          },
          {
            "type": "field",
            "component": "text",
            "text": "@desc.1",
            "className": "card-footer"
          }
        ]
      }
    },
    "back": {
      "repeat": "@",
      "layout": {
        "type": "stack",
        "gap": 4,
        "children": [
          {
            "type": "field",
            "component": "text",
            "text": "@name",
            "className": "card-title",
            "textSize": "lg",
            "textStyles": {
              "bold": true
            }
          },
          {
            "type": "field",
            "component": "text",
            "text": "@desc.2",
            "className": "card-body-text"
          },
          {
            "type": "field",
            "component": "text",
            "text": "@higher_level.0",
            "className": "card-footer"
          }
        ]
      }
    }
  }
}
