{
  "server": {
    "host": "127.0.0.1",
    "port": 8000,
    "cors_origin": "",
    "session_ttl_days": 7,
    "config_watch": false,
    "log_level": "info",
    "require_email_verification": true,
    "debug_verification_codes": false,
    "seed_dev_accounts": false,
    "require_invite": false,
    "environment_label": "",
    "local_file_access": false,
    "trusted_proxies": [],
    "static_roots": [
      "undercroft"
    ],
    "ddb_proxy_allowed_hosts": [
      "www.dndbeyond.com",
      "dndbeyond.com",
      "monster-service.dndbeyond.com",
      "character-service.dndbeyond.com"
    ]
  },
  "database": {
    "path": "data/database.sqlite"
  },
  "email": {
    "enabled": false,
    "sender": "admin@example.com",
    "smtp_host": "",
    "smtp_port": 587,
    "smtp_username": "",
    "smtp_password": "",
    "use_tls": true,
    "use_ssl": false,
    "timeout": 10
  },
  "mounts": [
    {
      "name": "loom-mappings",
      "type": "static",
      "root": "undercroft/loom/mappings",
      "directory_listing": true,
      "directory_extensions": [
        ".json"
      ]
    }
  ]
}
